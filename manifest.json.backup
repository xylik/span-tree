{
  "manifest_version": 3,
  "name": "SpanTree",
  "description": "Tree for Gitlab",
  "version": "0.0.5.2",
  "background": {
    "service_worker": "event.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SpanTree",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.png",
        "*.woff2",
        "*.svg",
        "*.css"
      ],
      "matches": [
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://gitlab.org/*",
        "https://*.gitlab.org/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://gitlab.org/*",
        "https://*.gitlab.org/*"
      ],
      "css": [],
      "js": [
        "content.js"
      ]
    },
    {
      "run_at": "document_start",
      "matches": [
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://gitlab.org/*",
        "https://*.gitlab.org/*"
      ],
      "css": [],
      "js": [
        "libs/contentDark.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}